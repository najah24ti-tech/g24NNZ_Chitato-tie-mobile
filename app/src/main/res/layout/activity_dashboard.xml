<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi, Najah!"
        android:textColor="@color/text_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Owner"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/txtWelcome"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spinnerMonth"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_background"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtRole"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtSales"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/card_background"
        android:padding="10dp"
        android:text="Total Sales&#10;Rp 150.000.000&#10;↑ 15%"
        android:textColor="@color/primary_blue"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/spinnerMonth"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtOrders"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/txtOrders"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:background="@drawable/card_background"
        android:padding="10dp"
        android:text="Total Order&#10;350&#10;↑ 10%"
        android:textColor="@color/primary_blue"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/txtSales"
        app:layout_constraintStart_toEndOf="@id/txtSales"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/txtPerformance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Sales Performance"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtSales"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtViewDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Details"
        android:textColor="@color/primary_blue"
        android:textSize="10sp"
        app:layout_constraintTop_toTopOf="@id/txtPerformance"
        app:layout_constraintBottom_toBottomOf="@id/txtPerformance"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtChart"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_background"
        android:gravity="center"
        android:text="Sales Trend&#10;／＼＿／＼＿／"
        android:textColor="@color/primary_blue"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/txtPerformance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Top Category"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtChart"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/categoryList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintVertical_bias="0">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skincare          ━━━━━━━"
            android:textColor="@color/primary_blue"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Makeup            ━━━━━"
            android:textColor="@color/chart_purple"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Haircare           ━━━━"
            android:textColor="@color/chart_pink"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_home_24"
            android:contentDescription="Home"
            android:padding="14dp"
            android:scaleType="fitCenter"
            app:tint="@color/primary_blue" />

        <ImageButton
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_bar_chart_24"
            android:contentDescription="Dashboard"
            android:padding="14dp"
            android:scaleType="fitCenter"
            app:tint="#111111" />

        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_person_24"
            android:contentDescription="Profile"
            android:padding="14dp"
            android:scaleType="fitCenter"
            app:tint="#555555" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>