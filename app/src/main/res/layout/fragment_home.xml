<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_home"
        app:title="Dashboard"
        app:titleTextColor="@color/text_dark" />

    <!-- Konten Dashboard -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_home"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Welcome -->
            <TextView
                android:id="@+id/txtWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hi, Najah!"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/txtRoleBadge" />

            <!-- Role Badge -->
            <TextView
                android:id="@+id/txtRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"
                android:text="OWNER"
                android:textColor="@color/primary_blue"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/txtWelcome"
                app:layout_constraintBottom_toBottomOf="@id/txtWelcome"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Deskripsi -->
            <TextView
                android:id="@+id/txtRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ringkasan penjualan skincare"
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/txtWelcome"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Periode Laporan -->
            <TextView
                android:id="@+id/txtPeriodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Periode laporan"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtRole"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/spinnerMonth"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_background"
                android:paddingHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtPeriodLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Kartu Total Sales -->
            <TextView
                android:id="@+id/txtSales"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/card_background"
                app:layout_constraintTop_toBottomOf="@id/spinnerMonth"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/txtOrders"
                app:layout_constraintHorizontal_weight="1" />

            <TextView
                android:id="@+id/txtSalesLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Total Sales"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@id/txtSales"
                app:layout_constraintStart_toStartOf="@id/txtSales"
                app:layout_constraintEnd_toEndOf="@id/txtSales" />

            <TextView
                android:id="@+id/txtSalesValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:text="Rp 150 jt"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtSalesLabel"
                app:layout_constraintStart_toStartOf="@id/txtSales"
                app:layout_constraintEnd_toEndOf="@id/txtSales" />

            <TextView
                android:id="@+id/txtSalesGrowth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="↑ 15% dari periode lalu"
                android:textColor="@color/primary_blue"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/txtSalesValue"
                app:layout_constraintStart_toStartOf="@id/txtSales"
                app:layout_constraintEnd_toEndOf="@id/txtSales" />

            <!-- Kartu Total Order -->
            <TextView
                android:id="@+id/txtOrders"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_background"
                app:layout_constraintTop_toBottomOf="@id/spinnerMonth"
                app:layout_constraintStart_toEndOf="@id/txtSales"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1" />

            <TextView
                android:id="@+id/txtOrdersLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="Total Order"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@id/txtOrders"
                app:layout_constraintStart_toStartOf="@id/txtOrders"
                app:layout_constraintEnd_toEndOf="@id/txtOrders" />

            <TextView
                android:id="@+id/txtOrdersValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:text="350"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtOrdersLabel"
                app:layout_constraintStart_toStartOf="@id/txtOrders"
                app:layout_constraintEnd_toEndOf="@id/txtOrders" />

            <TextView
                android:id="@+id/txtOrdersGrowth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="↑ 10% dari periode lalu"
                android:textColor="@color/primary_blue"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@id/txtOrdersValue"
                app:layout_constraintStart_toStartOf="@id/txtOrders"
                app:layout_constraintEnd_toEndOf="@id/txtOrders" />

            <!-- Sales Performance -->
            <TextView
                android:id="@+id/txtPerformance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Sales Performance"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtSales"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/txtViewDetails" />

            <TextView
                android:id="@+id/txtViewDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Details"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@id/txtPerformance"
                app:layout_constraintBottom_toBottomOf="@id/txtPerformance"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Grafik Penjualan -->
            <LinearLayout
                android:id="@+id/chartCard"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtPerformance">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tren Penjualan"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.example.nnz_chitato.SalesChartView
                    android:id="@+id/salesChart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- Quick Menu -->
            <TextView
                android:id="@+id/txtQuickMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Quick Menu"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/chartCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- GridView CustomAdapter: 2 menu -->
            <GridView
                android:id="@+id/gridHomeMenu"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:numColumns="2"
                android:horizontalSpacing="10dp"
                android:verticalSpacing="8dp"
                android:stretchMode="columnWidth"
                android:gravity="center"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@id/txtQuickMenu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Top Category -->
            <TextView
                android:id="@+id/txtCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Top Category"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/gridHomeMenu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Top Category Progress -->
            <LinearLayout
                android:id="@+id/categoryList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/txtCategory"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Skincare -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Skincare"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60%"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="14dp"
                    android:max="100"
                    android:progress="60"
                    android:progressTint="@color/primary_blue"
                    android:progressBackgroundTint="#E5EAF5" />

                <!-- Makeup -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Makeup"
                        android:textColor="@color/chart_purple"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25%"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="14dp"
                    android:max="100"
                    android:progress="25"
                    android:progressTint="@color/chart_purple"
                    android:progressBackgroundTint="#E5EAF5" />

                <!-- Haircare -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Haircare"
                        android:textColor="@color/chart_pink"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15%"
                        android:textColor="@color/text_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:progress="15"
                    android:progressTint="@color/chart_pink"
                    android:progressBackgroundTint="#E5EAF5" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</LinearLayout>
